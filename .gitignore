# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Service account keys (Google / Supabase / etc.)
fosen-tools-analytics-*.json
*-credentials.json
*-service-account*.json

# Lokale arbeidsfiler (ikke kode)
/Fosen Tools Brosjyre/
/Fosen Tools Nettside Utsende/

# Generert sitemap (publiseres separat)
/sitemap.xml

# R / RStudio (junk-historikk-filer)
.Rhistory
.RData
.Ruserdata

# Claude Code worktrees (intern sesjonsstate)
.claude/worktrees/

# Tunge media for Remotion-komposisjoner (skal i Supabase Storage, ikke Git)
/public/social/overlays/
/public/social/sfx/
